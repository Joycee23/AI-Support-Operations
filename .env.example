GEMINI_API_KEY=
PORT=8000
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_ops
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
UPLOAD_DIR=./data/uploads

# Set true when serving the app over HTTPS in production.
COOKIE_SECURE=false

# SePay subscription payments (VND / workspace / calendar month)
SUBSCRIPTION_MONTHLY_PRICE_VND=499000
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# Invitation emails: Gmail SMTP uses an App Password, never the account password.
APP_PUBLIC_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Support Operations

# Optional 9router generation; Gemini remains required for embeddings.
# Set AI_PROVIDER=9router after filling NINEROUTER_API_KEY.
AI_PROVIDER=gemini
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_DOCKER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=codexlite/gpt-6-luna
NINEROUTER_FALLBACK_MODELS=codexlite/gpt-6-sol
NINEROUTER_GEMINI_FALLBACK=true

# init_security.py writes missing keys into .env without displaying them.
APP_ENV=development
APP_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production only: configure separate database/password; see SECURITY.md.
APP_DOMAIN=
POSTGRES_PASSWORD=support
DOCKER_DATABASE_URL=postgresql+psycopg://support:support@db:5432/support_ops
# Administration host only; never pass this value into the app container.
DATABASE_MIGRATION_URL=

# Limits shared across workers via PostgreSQL; values must be positive.
API_IP_PER_MINUTE=600
API_USER_PER_MINUTE=180
API_WORKSPACE_PER_MINUTE=1800
API_WRITES_PER_MINUTE=40
AI_USER_PER_MINUTE=5
AI_WORKSPACE_PER_MINUTE=20
AI_WORKSPACE_PER_DAY=300
AI_GLOBAL_PER_DAY=5000
AI_USER_CONCURRENCY=1
AI_WORKSPACE_CONCURRENCY=3
AI_GLOBAL_CONCURRENCY=12
AI_MAX_PROVIDER_ATTEMPTS=4
INGEST_GLOBAL_CONCURRENCY=3
UPLOADS_PER_HOUR=20
KNOWLEDGE_WORKSPACE_MAX_ITEMS=1000
UPLOAD_WORKSPACE_BYTES=268435456
UPLOAD_MIN_FREE_BYTES=1073741824
EMBEDDING_WORKSPACE_CHUNKS_PER_DAY=2000
EMBEDDING_GLOBAL_CHUNKS_PER_DAY=20000

# Public age recipient; private identity belongs offline.
BACKUP_AGE_RECIPIENT=

# Trusted administration host / migration job ONLY (never app container)
DATABASE_MIGRATION_URL=
DOCKER_DATABASE_MIGRATION_URL=
# Private R2/S3 bucket; encrypted ciphertext only. See OPERATIONS.md
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=support-ops/
MONITOR_APP_URL=http://localhost:8000
MONITOR_ALERT_EMAIL=
MONITOR_MIN_FREE_BYTES=2147483648
MONITOR_AI_FAILURES=3
